{
  "name": "xailinx",
  "version": "15.0.2",
  "description": "XAIlinx ISE (Integrated Synthesis Environment): HDL design platform in the style of Xilinx ISE 14.x: VHDL/Verilog projects, schematic and ASM editors, behavioural simulation, ISE 14.7 implementation and board programming",
  "type": "module",
  "bin": {
    "xailinx": "bin/xailinx.js"
  },
  "scripts": {
    "start": "node bin/xailinx.js serve",
    "test": "node --test test/*.test.js",
    "build:standalone": "node scripts/build-standalone.mjs",
    "version": "node scripts/sync-version.mjs && git add core/version.js"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "codemirror": "^5.65.21",
    "elkjs": "^0.9.3",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pmnmalo/XAIlinx-ISE.git"
  },
  "author": "Pedro Malo"
}
