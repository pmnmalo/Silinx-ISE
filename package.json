{
  "name": "silinx-ise",
  "version": "15.10.22",
  "description": "Silinx ISE (Integrated Synthesis Environment): HDL design platform in the style of Xilinx ISE 14.x: VHDL/Verilog projects, schematic and ASM editors, behavioural simulation, synthesis, place & route and bitstreams (its own toolchain for the Basys2 / Nexys2, or Xilinx ISE 14.7) and board programming from the browser",
  "type": "module",
  "bin": {
    "silinx-ise": "bin/silinx-ise.js"
  },
  "scripts": {
    "start": "node bin/silinx-ise.js serve",
    "test": "node --test test/*.test.js",
    "test:ui": "node --test test/ui/*.test.js",
    "test:ise": "SILINX_ISE_TESTS=1 node --test test/ise/*.test.js",
    "check:open-flow": "node scripts/check-open-flow.mjs",
    "test:webkit": "node --test test/webkit/*.test.js",
    "test:release": "node --test test/release/*.test.js",
    "test:browsers": "node scripts/test-browsers.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:corpus": "node test/corpus/run-corpus.mjs",
    "test:vloghammer": "node test/corpus/vloghammer.mjs",
    "test:designs": "node test/designs-corpus/run.mjs",
    "fetch:designs": "node scripts/fetch-design-corpus.mjs",
    "test:diagrams": "node --test test/diagram-corpus/*.test.js",
    "fetch:diagrams": "node scripts/fetch-diagram-corpus.mjs",
    "fetch:yosys-tests": "node scripts/fetch-yosys-tests.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "version": "node scripts/sync-version.mjs && git add core/version.js"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@yowasp/yosys": "0.70.1258",
    "codemirror": "^5.65.21",
    "elkjs": "^0.12.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.64.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pmnmalo/Silinx-ISE.git"
  },
  "author": "Pedro Maló"
}
