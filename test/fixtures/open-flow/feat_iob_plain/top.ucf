# Basys2-250: the pins this board test uses; the registers into their pads' IOBs (#96), on the four sides (#671: the
# left and right pads' register clocks through the I/O columns' clock rows, the top pads' from the global lines)
NET "clk"    LOC = "B8" | IOSTANDARD = LVCMOS33 ;
NET "clk"    CLOCK_DEDICATED_ROUTE = FALSE ;
NET "sw<0>"  LOC = "P11" | IOSTANDARD = LVCMOS33 ;
NET "sw<1>"  LOC = "L3" | IOSTANDARD = LVCMOS33 ;
NET "sw<2>"  LOC = "K3" | IOSTANDARD = LVCMOS33 ;
NET "sw<3>"  LOC = "B4" | IOSTANDARD = LVCMOS33 ;
NET "sw<4>"  LOC = "G3" | IOSTANDARD = LVCMOS33 ;
NET "sw<5>"  LOC = "F3" | IOSTANDARD = LVCMOS33 ;
NET "sw<6>"  LOC = "E2" | IOSTANDARD = LVCMOS33 ;
NET "sw<7>"  LOC = "N3" | IOSTANDARD = LVCMOS33 ;
NET "btn<0>" LOC = "G12" | IOSTANDARD = LVCMOS33 ;
NET "btn<1>" LOC = "C11" | IOSTANDARD = LVCMOS33 ;
NET "btn<2>" LOC = "M4" | IOSTANDARD = LVCMOS33 ;
NET "btn<3>" LOC = "A7" | IOSTANDARD = LVCMOS33 ;
NET "led<0>" LOC = "M5" | IOSTANDARD = LVCMOS33 ;
NET "led<1>" LOC = "M11" | IOSTANDARD = LVCMOS33 ;
NET "led<2>" LOC = "P7" | IOSTANDARD = LVCMOS33 ;
NET "led<3>" LOC = "P6" | IOSTANDARD = LVCMOS33 ;
NET "led<4>" LOC = "N5" | IOSTANDARD = LVCMOS33 ;
NET "led<5>" LOC = "N4" | IOSTANDARD = LVCMOS33 ;
NET "led<6>" LOC = "P4" | IOSTANDARD = LVCMOS33 ;
NET "led<7>" LOC = "G1" | IOSTANDARD = LVCMOS33 ;
NET "an<0>"  LOC = "F12" | IOSTANDARD = LVCMOS33 ;
NET "an<1>"  LOC = "J12" | IOSTANDARD = LVCMOS33 ;
NET "an<2>"  LOC = "M13" | IOSTANDARD = LVCMOS33 ;
NET "an<3>"  LOC = "K14" | IOSTANDARD = LVCMOS33 ;
NET "clk" TNM_NET = "clk" ;
TIMESPEC "TS_clk" = PERIOD "clk" 20 ns HIGH 50% ;
NET "sw<*>" IOB = TRUE ;
# (N3, an input-only pad, one of the two control inputs of the measurements' designs: its input register not measured)
NET "sw<7>" IOB = FALSE ;
NET "btn<*>" IOB = TRUE ;
NET "led<*>" IOB = TRUE ;
NET "an<*>" IOB = TRUE ;
