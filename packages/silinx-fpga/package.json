{
  "name": "silinx-fpga",
  "version": "0.2.0",
  "description": "The Silinx toolchain for Spartan-3E FPGAs without Xilinx tools: synthesis with Yosys in WebAssembly, then pack, place, route, timing and bitstream, with the device data",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./parts": "./src/parts.js",
    "./node": "./src/node.js"
  },
  "bin": {
    "silinx-fpga": "bin/silinx-fpga.js"
  },
  "files": [
    "src",
    "bin",
    "bitdb",
    "devices",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmnmalo/Silinx-ISE.git",
    "directory": "packages/silinx-fpga"
  },
  "license": "Apache-2.0",
  "author": "Pedro Maló",
  "dependencies": {
    "@silinx/nextpnr-himbaechel-spartan3e": "0.13.0",
    "@silinx/nextpnr-himbaechel-spartan6": "https://github.com/pmnmalo/nextpnr-spartan/releases/download/spartan6-v0.1.1/silinx-nextpnr-himbaechel-spartan6-0.1.1.tgz",
    "@yowasp/yosys": "0.70.1258"
  },
  "peerDependencies": {
    "@yowasp/nextpnr-ice40": "0.11.96-dev.805"
  },
  "peerDependenciesMeta": {
