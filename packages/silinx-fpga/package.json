{
  "name": "silinx-fpga",
  "version": "0.1.0",
  "description": "The Silinx toolchain for Spartan-3E FPGAs without Xilinx tools: synthesis with Yosys in WebAssembly, then pack, place, route, timing and bitstream, with the device data",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./parts": "./src/parts.js",
    "./node": "./src/node.js"
  },
  "bin": {
    "silinx-fpga": "bin/silinx-fpga.js"
  },
  "files": [
    "src",
    "bin",
    "bitdb",
    "devices",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "private": true,
  "license": "Apache-2.0",
  "author": "Pedro Maló",
  "dependencies": {
    "@silinx/nextpnr-himbaechel-spartan3e": "https://github.com/pmnmalo/nextpnr-spartan/releases/download/v0.1.0/silinx-nextpnr-himbaechel-spartan3e-0.1.0.tgz",
    "@yowasp/yosys": "0.70.1258"
  }
}
