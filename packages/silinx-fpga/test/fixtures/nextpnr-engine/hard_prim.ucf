# every pad LVCMOS33 (the banks of the Basys2 are at 3.3 V)
NET "clk" LOC = "B8" | IOSTANDARD = LVCMOS33 ;
NET "s<0>" IOSTANDARD = LVCMOS33 ;
NET "s<1>" IOSTANDARD = LVCMOS33 ;
NET "s<2>" IOSTANDARD = LVCMOS33 ;
NET "s<3>" IOSTANDARD = LVCMOS33 ;
NET "y<0>" IOSTANDARD = LVCMOS33 ;
NET "y<1>" IOSTANDARD = LVCMOS33 ;
NET "y<2>" IOSTANDARD = LVCMOS33 ;
NET "y<3>" IOSTANDARD = LVCMOS33 ;
NET "y<4>" IOSTANDARD = LVCMOS33 ;
NET "y<5>" IOSTANDARD = LVCMOS33 ;
NET "y<6>" IOSTANDARD = LVCMOS33 ;
NET "y<7>" IOSTANDARD = LVCMOS33 ;
NET "clk" TNM_NET = "clk" ;
TIMESPEC "TS_clk" = PERIOD "clk" 20 ns HIGH 50% ;
