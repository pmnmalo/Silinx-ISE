# Basys2-250 (#2135): research/nextpnr-s3e/iob_regs.v, its registers in the IOBs of sw<0> (input), led<0> (output) and
# led<1> (output and output-enable); the IDDR2 on L3, the ODDR2 on M11; the clock on B8, a GCLK pin
NET "clk"    LOC = "B8" | IOSTANDARD = LVCMOS25 ;
NET "sw<0>"  LOC = "P11" | IOSTANDARD = LVCMOS25 | IOB = TRUE ;
NET "sw<1>"  LOC = "L3" | IOSTANDARD = LVCMOS25 ;
NET "sw<2>"  LOC = "K3" | IOSTANDARD = LVCMOS25 ;
NET "sw<3>"  LOC = "B4" | IOSTANDARD = LVCMOS25 ;
NET "btn<0>" LOC = "G12" | IOSTANDARD = LVCMOS25 ;
NET "btn<1>" LOC = "H13" | IOSTANDARD = LVCMOS25 ;
NET "led<0>" LOC = "M5" | IOSTANDARD = LVCMOS25 | IOB = TRUE ;
NET "led<1>" LOC = "P6" | IOSTANDARD = LVCMOS25 | IOB = TRUE ;
NET "led<2>" LOC = "M11" | IOSTANDARD = LVCMOS25 ;
NET "led<3>" LOC = "P7" | IOSTANDARD = LVCMOS25 ;
NET "clk" TNM_NET = "clk" ;
TIMESPEC "TS_clk" = PERIOD "clk" 20 ns HIGH 50% ;
